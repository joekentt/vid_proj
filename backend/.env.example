# Copie para .env e ajuste. SEM .env, os defaults do config.py já apontam
# para o docker-compose local (Redis + MinIO) — nada disto é obrigatório
# para desenvolver localmente.
#
# NUNCA commite o .env real: ele contém credenciais (está no .gitignore).

# --- Redis (fila de jobs) ---
# Local (docker compose up):
#   REDIS_URL=redis://localhost:6379/0
# Upstash (TLS — note o esquema rediss:// com dois "s"):
#   REDIS_URL=rediss://default:SUA_SENHA@nome-do-db-12345.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# --- Storage S3-like (MinIO local por padrão) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-video-studio

# --- Provedores cloud opcionais ---
REPLICATE_API_TOKEN=
